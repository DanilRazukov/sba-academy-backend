# Порт HTTP-сервера
PORT=8080

# Origin'ы лендинга через запятую (CORS). "*" — любой, только для отладки.
ALLOWED_ORIGINS=https://academysba.pro,https://sba-academy.vercel.app,http://localhost:3000

# true, если сервис стоит за nginx/балансировщиком: IP клиента берётся из X-Forwarded-For.
# Без прокси оставить false — иначе заголовок подделает кто угодно.
TRUST_PROXY=false

# Не больше RATE_LIMIT_MAX заявок за RATE_LIMIT_WINDOW с одного IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=10m

# --- Telegram (оба значения или ни одного) ---
# токен от @BotFather
TELEGRAM_BOT_TOKEN=
# id чата/группы/канала; у групп отрицательный, например -1001234567890
TELEGRAM_CHAT_ID=

# --- Почта (SMTP_HOST пустой — канал выключен) ---
SMTP_HOST=smtp.yandex.ru
# 465 — TLS сразу; 587 — STARTTLS
SMTP_PORT=465
# логин и он же отправитель: письма уходят от «SBA Academy <SMTP_USERNAME>»
SMTP_USERNAME=noreply@academysba.pro
# пароль приложения, не основной пароль ящика
SMTP_PASSWORD=
# получатели заявок через запятую
SMTP_TO=manager@academysba.pro
